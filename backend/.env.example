# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL (local dev). The installer in README sets the superuser password to wizforge_dev.
DATABASE_URL=postgresql+psycopg://postgres:wizforge_dev@localhost:5432/wizforge

# Generate a long random value for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
JWT_EXPIRE_MINUTES=1440

# Claude API. Leave blank to run with static analysis only.
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium

CORS_ORIGINS=http://localhost:5173
MAX_CODE_CHARS=100000
